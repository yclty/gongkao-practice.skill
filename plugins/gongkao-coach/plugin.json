{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "gongkao-coach",
  "version": "1.0.0",
  "description": "Local-first AI exam coach with shared browser/chat progress, isolated learner databases and durable adaptive training.",
  "homepage": "https://github.com/yclty/gongkao-practice.skill",
  "repository": "https://github.com/yclty/gongkao-practice.skill",
  "license": "AGPL-3.0",
  "keywords": [
    "gongkao",
    "study",
    "quiz",
    "spaced-repetition"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "考公上岸 Coach",
        "shortDescription": "本地保存进度，多人各自持续备考",
        "longDescription": "每个人使用自己的本地学习档案，网页与 AI 聊天共享自动保存的进度。支持诊断、专项、基础过关、错因复习和严格整卷模拟，换聊天与重启后继续。",
        "defaultPrompt": [
          "初始化我的考公系统",
          "开始练习",
          "按我的学习路线开始"
        ],
        "brandColor": "#2F6B4F",
        "brandColorDark": "#8FD3B0",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/logo.svg",
        "category": "Education & Research"
      },
      "onboardingSkill": "./skills/gongkao-onboarding/SKILL.md"
    }
  }
}
